msgstr ""
"Un descripteur du thésaurus de l'APA (PsycINFO) : %(plain)s, ou %(exploded)s avec les "
"descripteurs plus spécifiques."

#, python-format
msgid "An exact phrase, in quotes (several words are always searched as a phrase): %(example)s."
msgstr ""
"Une expression exacte, entre guillemets (plusieurs mots sont toujours cherchés comme une "
